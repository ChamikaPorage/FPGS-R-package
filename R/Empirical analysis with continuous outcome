# ============================================================
# EMPIRICAL ANALYSIS USING THE FPGS PACKAGE
#
# Data: df_all.csv
# Outcome: lead
# Treatment: smoking
#
# FPGS methods:
#   1. Parametric
#   2. Random forest
#
# ATE estimators:
#   1. Regression imputation (RI)
#   2. Matching
#   3. IPW
#   4. NIPW
#   5. AIPW
#   6. Stratification
#
# Inference:
#   Nonparametric bootstrap
#   B = 1000
#   Percentile 95% confidence intervals
# ============================================================


# ============================================================
# 1. WORKING DIRECTORY
# ============================================================

setwd("C:/Users/dmgda/OneDrive/Documents/Chamika/R package")


# ============================================================
# 2. LOAD REQUIRED PACKAGES
# ============================================================

library(dplyr)
library(ranger)
library(caret)
library(Matching)


# ============================================================
# 3. SOURCE FPGS FUNCTIONS
# ============================================================

# Main FPGS dispatcher
source("fpgs.R")

# FPGS estimation
source("fpgs_continuous_parametric.R")
source("fpgs_continuous_rf.R")
source("fpgs_binary_parametric.R")
source("fpgs_binary_rf.R")

# ATE estimators
source("fpgs_ri.R")
source("fpgs_matching.R")
source("fpgs_stratification.R")
source("fpgs_ipw.R")

# Analytic variance functions
source("parametric_variance_for_ri.R")
source("parametric_variance_for_weighting.R")

# Bootstrap
source("fpgs_bootstrap.R")

# Combined ATE function
source("fpgs_ate.R")


# ============================================================
# 4. CHECK THAT FUNCTIONS ARE AVAILABLE
# ============================================================

required_functions <- c(
  "fpgs",
  "fpgs_ri",
  "fpgs_match",
  "fpgs_stratify",
  "fpgs_weight",
  "fpgs_bootstrap",
  "fpgs_ate"
)

function_check <- sapply(
  required_functions,
  exists,
  mode = "function"
)

print(function_check)

if (!all(function_check)) {
  stop(
    "Some required FPGS functions are missing. ",
    "Check the sourced R files."
  )
}


# ============================================================
# 5. READ EMPIRICAL DATA
# ============================================================

datat <- read.csv("df_all.csv")


# Basic checks
dim(datat)
names(datat)
summary(datat$lead)
table(datat$smoking)
sum(is.na(datat))


# ============================================================
# 6. RECODE GENDER
# ============================================================

datat <- datat %>%
  mutate(
    gender = case_when(
      gender == 1 ~ 1,
      gender == 2 ~ 0,
      TRUE ~ NA_real_
    )
  )

table(datat$gender, useNA = "ifany")


# ============================================================
# 7. CREATE COVARIATE DESIGN MATRIX
# ============================================================

X.matrix <- model.matrix(
  smoking ~
    married.living.with.partner +
    birth.country +
    edu +
    race +
    income +
    army.service +
    c.age +
    c.age2 +
    c.family.size +
    gender,
  data = datat
)


# Convert to data frame
dat.X <- as.data.frame(X.matrix)


# Remove intercept
dat.X <- dat.X[, -1, drop = FALSE]


# Remove incomeOther as in the previous empirical analysis
dat.X <- dat.X[
  ,
  !names(dat.X) %in% "incomeOther",
  drop = FALSE
]


# Check generated covariates
names(dat.X)
dim(dat.X)


# ============================================================
# 8. CREATE DATA SET USED BY FPGS
# ============================================================

dat_pkg <- data.frame(
  lead = datat$lead,
  smoking = datat$smoking,
  dat.X
)


covariates <- setdiff(
  names(dat_pkg),
  c("lead", "smoking")
)


# Check
dim(dat_pkg)
names(dat_pkg)
length(covariates)

table(dat_pkg$smoking)
summary(dat_pkg$lead)

sum(is.na(dat_pkg))


# Treatment must be 0/1
if (!all(dat_pkg$smoking %in% c(0, 1))) {
  stop("Smoking must be coded 0/1.")
}


# ============================================================
# 9. DESCRIPTIVE INFORMATION
# ============================================================

cat("\nSample size:", nrow(dat_pkg), "\n")

cat(
  "Untreated:",
  sum(dat_pkg$smoking == 0),
  "\n"
)

cat(
  "Treated:",
  sum(dat_pkg$smoking == 1),
  "\n"
)

cat(
  "Mean lead:",
  mean(dat_pkg$lead),
  "\n"
)

cat(
  "SD lead:",
  sd(dat_pkg$lead),
  "\n"
)


# ============================================================
# PART A
# PARAMETRIC FPGS
# ============================================================


# ============================================================
# 10. ESTIMATE PARAMETRIC FPGS
# ============================================================

fit_par <- fpgs(
  data = dat_pkg,
  outcome = "lead",
  treatment = "smoking",
  covariates = covariates,
  outcome_type = "continuous",
  method = "parametric"
)


# Inspect fit
print(fit_par)

summary(fit_par$mu0_hat)
summary(fit_par$mu1_hat)

head(fit_par$fpgs)


# ============================================================
# 11. PARAMETRIC POINT ESTIMATES
# ============================================================


# Regression imputation
ri_par <- fpgs_ri(fit_par)


# Matching
match_par <- fpgs_match(
  fit_par,
  M = 1
)


# IPW
ipw_par <- fpgs_weight(
  fit_par,
  type = "ipw"
)


# NIPW
nipw_par <- fpgs_weight(
  fit_par,
  type = "nipw"
)


# AIPW
aipw_par <- fpgs_weight(
  fit_par,
  type = "aipw"
)


# Stratification
strat_par <- fpgs_stratify(
  fit_par,
  n_bins = 4,
  min_cell = 3
)


# ============================================================
# 12. DISPLAY PARAMETRIC POINT ESTIMATES
# ============================================================

point_par <- data.frame(
  
  estimator = c(
    "RI",
    "Matching",
    "IPW",
    "NIPW",
    "AIPW",
    "Stratification"
  ),
  
  estimate = c(
    ri_par$estimate,
    match_par$estimate,
    ipw_par$estimate,
    nipw_par$estimate,
    aipw_par$estimate,
    strat_par$estimate
  )
)

print(point_par)


# ============================================================
# 13. STRATIFICATION DIAGNOSTICS
# ============================================================

cat(
  "\nParametric FPGS stratification:\n"
)

cat(
  "Retained strata:",
  strat_par$n_retained_strata,
  "\n"
)

cat(
  "Dropped strata:",
  strat_par$n_dropped_strata,
  "\n"
)

cat(
  "Dropped observations:",
  strat_par$n_dropped_obs,
  "\n"
)

cat(
  "Retained observations:",
  strat_par$n_retained_obs,
  "\n"
)


# ============================================================
# 14A. PARAMETRIC ANALYTIC INFERENCE
# ============================================================

results_par_analytic <- fpgs_ate(
  fit = fit_par,
  inference = "analytic",
  conf.level = 0.95,
  M = 1,
  n_bins = 4,
  min_cell = 3
)

results_par_analytic$FPGS_method <- "Parametric"
results_par_analytic$Inference <- "Analytic"

results_par_analytic <- results_par_analytic[
  ,
  c(
    "FPGS_method",
    "Inference",
    "estimator",
    "estimate",
    "variance",
    "se",
    "ci_lower",
    "ci_upper"
  )
]

print(results_par_analytic)


# ============================================================
# 14B. PARAMETRIC BOOTSTRAP INFERENCE
#
# Use B = 20 while testing.
# Change to B = 1000 for final analysis.
# ============================================================

set.seed(2026)

results_par_bootstrap <- fpgs_ate(
  fit = fit_par,
  inference = "bootstrap",
  B = 100,
  conf.level = 0.95,
  M = 1,
  n_bins = 4,
  min_cell = 3
)

results_par_bootstrap$FPGS_method <- "Parametric"
results_par_bootstrap$Inference <- "Bootstrap"

results_par_bootstrap <- results_par_bootstrap[
  ,
  c(
    "FPGS_method",
    "Inference",
    "estimator",
    "estimate",
    "variance",
    "se",
    "ci_lower",
    "ci_upper"
  )
]

print(results_par_bootstrap)

# ============================================================
# PART B
# RANDOM FOREST FPGS
# ============================================================


# ============================================================
# 15. ESTIMATE RANDOM FOREST FPGS
# ============================================================

set.seed(2026)

fit_rf <- fpgs(
  data = dat_pkg,
  outcome = "lead",
  treatment = "smoking",
  covariates = covariates,
  outcome_type = "continuous",
  method = "rf",
  folds = 5,
  num.trees = 300,
  mtry = 2,
  min.node.size = 5
)


# Inspect fit
print(fit_rf)

summary(fit_rf$mu0_hat)
summary(fit_rf$mu1_hat)

head(fit_rf$fpgs)


# ============================================================
# 16. RANDOM FOREST POINT ESTIMATES
# ============================================================


# Regression imputation
set.seed(2026)

ri_rf <- fpgs_ri(fit_rf)


# Matching
match_rf <- fpgs_match(
  fit_rf,
  M = 1
)


# IPW
ipw_rf <- fpgs_weight(
  fit_rf,
  type = "ipw"
)


# NIPW
nipw_rf <- fpgs_weight(
  fit_rf,
  type = "nipw"
)


# AIPW
aipw_rf <- fpgs_weight(
  fit_rf,
  type = "aipw"
)


# Stratification
strat_rf <- fpgs_stratify(
  fit_rf,
  n_bins = 5,
  min_cell = 5
)


# ============================================================
# 17. DISPLAY RF POINT ESTIMATES
# ============================================================

point_rf <- data.frame(
  
  estimator = c(
    "RI",
    "Matching",
    "IPW",
    "NIPW",
    "AIPW",
    "Stratification"
  ),
  
  estimate = c(
    ri_rf$estimate,
    match_rf$estimate,
    ipw_rf$estimate,
    nipw_rf$estimate,
    aipw_rf$estimate,
    strat_rf$estimate
  )
)

print(point_rf)


# ============================================================
# 18. RF STRATIFICATION DIAGNOSTICS
# ============================================================

cat(
  "\nRandom forest FPGS stratification:\n"
)

cat(
  "Retained strata:",
  strat_rf$n_retained_strata,
  "\n"
)

cat(
  "Dropped strata:",
  strat_rf$n_dropped_strata,
  "\n"
)

cat(
  "Dropped observations:",
  strat_rf$n_dropped_obs,
  "\n"
)

cat(
  "Retained observations:",
  strat_rf$n_retained_obs,
  "\n"
)


# ============================================================
# 19. RANDOM FOREST BOOTSTRAP INFERENCE
#
# B = 1000
# ============================================================

set.seed(2026)

results_rf <- fpgs_ate(
  fit = fit_rf,
  inference = "bootstrap",
  B = 100,
  conf.level = 0.95,
  M = 1,
  n_bins = 4,
  min_cell = 3
)


results_rf$FPGS_method <- "Random forest"
results_rf$Inference <- "Bootstrap"

results_rf <- results_rf[
  ,
  c(
    "FPGS_method",
    "Inference",
    "estimator",
    "estimate",
    "variance",
    "se",
    "ci_lower",
    "ci_upper"
  )
]

print(results_rf)

print(names(results_par_analytic))
print(names(results_par_bootstrap))
print(names(results_rf))


# ============================================================
# 20. COMBINE PARAMETRIC AND RF RESULTS
# ============================================================

results_all <- rbind(
  results_par_analytic,
  results_par_bootstrap,
  results_rf
)


print(results_all)


# ============================================================
# 21. CREATE ROUNDED FINAL TABLE
# ============================================================

results_table <- results_all


numeric_columns <- c(
  "estimate",
  "variance",
  "se",
  "ci_lower",
  "ci_upper"
)


results_table[numeric_columns] <- lapply(
  results_table[numeric_columns],
  round,
  digits = 4
)


print(results_table)


# ============================================================
# 22. STRATIFICATION DIAGNOSTICS TABLE
# ============================================================

stratification_diagnostics <- data.frame(
  
  FPGS_method = c(
    "Parametric",
    "Random forest"
  ),
  
  retained_strata = c(
    strat_par$n_retained_strata,
    strat_rf$n_retained_strata
  ),
  
  dropped_strata = c(
    strat_par$n_dropped_strata,
    strat_rf$n_dropped_strata
  ),
  
  retained_observations = c(
    strat_par$n_retained_obs,
    strat_rf$n_retained_obs
  ),
  
  dropped_observations = c(
    strat_par$n_dropped_obs,
    strat_rf$n_dropped_obs
  )
)


print(stratification_diagnostics)


# ============================================================
# 23. SAVE RESULTS
# ============================================================

write.csv(
  results_table,
  file = "df_all_FPGS_bootstrap_results.csv",
  row.names = FALSE
)


write.csv(
  stratification_diagnostics,
  file = "df_all_FPGS_stratification_diagnostics.csv",
  row.names = FALSE
)


# ============================================================
# 24. SAVE UNROUNDED RESULTS AS R OBJECT
# ============================================================

saveRDS(
  results_all,
  file = "df_all_FPGS_bootstrap_results.rds"
)


# ============================================================
# 25. SAVE UNROUNDED RESULTS AS R OBJECT
# ============================================================

saveRDS(
  results_all,
  file = "df_all_FPGS_results_unrounded.rds"
)


# ============================================================
# 26. FINAL DISPLAY
# ============================================================

cat("\n============================================\n")
cat("FINAL FPGS EMPIRICAL RESULTS\n")
cat("============================================\n")
cat("Parametric FPGS:\n")
cat("  - Analytic inference\n")
cat("  - Bootstrap inference\n")
cat("Random forest FPGS:\n")
cat("  - Bootstrap inference\n")
cat("Confidence level: 95%\n")
cat("============================================\n\n")

print(results_table)
