# ============================================================
# 5. HELPER FUNCTION:
# KEEP COVARIATES IDENTIFIABLE IN BOTH TREATMENT GROUPS
# ============================================================

make_group_full_rank <- function(
    X,
    treatment,
    tol = 1e-7
) {
  
  X <- as.matrix(X)
  
  
  # Rank in full sample
  qr_all <- qr(
    X,
    tol = tol
  )
  
  
  # Rank among treated
  qr_1 <- qr(
    X[
      treatment == 1,
      ,
      drop = FALSE
    ],
    tol = tol
  )
  
  
  # Rank among untreated
  qr_0 <- qr(
    X[
      treatment == 0,
      ,
      drop = FALSE
    ],
    tol = tol
  )
  
  
  # Retain columns estimable in all three
  keep <- Reduce(
    intersect,
    list(
      
      qr_all$pivot[
        seq_len(qr_all$rank)
      ],
      
      qr_1$pivot[
        seq_len(qr_1$rank)
      ],
      
      qr_0$pivot[
        seq_len(qr_0$rank)
      ]
      
    )
  )
  
  
  X[
    ,
    sort(keep),
    drop = FALSE
  ]
  
}



